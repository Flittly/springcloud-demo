<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.flittly.mapper.TOrderMapper">

    <resultMap id="BaseResultMap" type="com.flittly.bean.TOrder">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="product_id" property="productId"/>
        <result column="count" property="count"/>
        <result column="money" property="money"/>
        <result column="status" property="status"/>
    </resultMap>

    <insert id="insert" parameterType="com.flittly.bean.TOrder"
            useGeneratedKeys="true" keyProperty="id">
        insert into t_order (`user_id`, `product_id`, `count`, `money`, `status`)
        values (#{userId}, #{productId}, #{count}, #{money}, #{status})
    </insert>

    <update id="updateStatus">
        update t_order
        set `status` = #{status}
        where id = #{orderId}
    </update>

    <select id="selectById" resultMap="BaseResultMap">
        select `id`, `user_id`, `product_id`, `count`, `money`, `status`
        from t_order
        where id = #{id}
    </select>

</mapper>
